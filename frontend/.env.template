# URL del backend NestJS (sin /api). La usan las rutas BFF en el servidor.
# Local: http://localhost:4000 | Dentro de Docker: http://backend:4000
API_URL=http://localhost:4000

# Debe ser el mismo valor que JWT_ACCESS_SECRET del backend: el proxy verifica la firma del token.
JWT_ACCESS_SECRET=

# Cookies de sesión solo por HTTPS. Por defecto true en producción; usa false solo si sirves por HTTP.
# SESSION_COOKIE_SECURE=true
