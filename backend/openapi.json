  "info": {
    "title": "LTGT System API",
    "description": "API para sistema de gestión de tickets, productos y base de conocimiento",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Endpoints de autenticación"
    },
    {
      "name": "users",
      "description": "Endpoints de gestión de usuarios"
    },
    {
      "name": "products",
      "description": "Endpoints de gestión de productos"
    },
    {
      "name": "brands",
      "description": "Endpoints de gestión de marcas"
    },
    {
      "name": "categories",
      "description": "Endpoints de gestión de categorías"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Ingresa tu token JWT",
        "in": "header"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@ltgt.local",
            "description": "Email del usuario"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "example": "Admin123!",
            "description": "Contraseña (mínimo 6 caracteres)"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "ADMIN",
          "SUPPORT"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "id",
          "email",
          "name"
        ]
      },
      "SessionTokensDto": {
        "type": "object",
        "properties": {
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string",
            "description": "Ausente cuando el refresh se reintenta dentro de la ventana de gracia"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessTokenExpiresAt",
          "accessToken",
          "user"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "description": "Refresh token recibido en el login o en el último refresh"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "role",
          "id",
          "email",
          "name",
          "createdAt"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "usuario@ltgt.local",
            "description": "Email del usuario (debe ser único)"
          },
          "name": {
            "type": "string",
            "example": "Usuario Apellido",
            "description": "Nombre completo del usuario"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "example": "Password123!",
            "description": "Contraseña del usuario (mínimo 6 caracteres)"
          },
          "role": {
            "example": "SUPPORT",
            "description": "Rol del usuario en el sistema",
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          }
        },
        "required": [
          "email",
          "name",
          "password",
          "role"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
